# EditorConfig is awesome: https://EditorConfig.org
# Aggressive but reasonable defaults for a cross-OS project (Win/macOS/Linux).

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
# Markdown is awkward to auto-trim; preserve trailing spaces (used for line breaks)
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.rs]
indent_size = 4
max_line_length = 100

[*.{ts,svelte,tsx,js,cjs,mjs}]
indent_size = 2
max_line_length = 100

[*.{yml,yaml,toml}]
indent_size = 2

[*.json]
indent_size = 2

[*.{png,jpg,jpeg,gif,ico,icns,webp,ttf,woff,woff2}]
binary = true

[Makefile]
indent_style = tab
